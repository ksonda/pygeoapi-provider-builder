{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pygeoapi-provider-builder/catalog/descriptor.schema.json",
  "title": "Provider descriptor (v1)",
  "description": "One file per pygeoapi provider. See PLAN.md §5.",
  "type": "object",
  "required": ["descriptor_version", "id", "provider_type", "title"],
  "additionalProperties": false,
  "properties": {
    "descriptor_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+$"},
    "base": {"type": "boolean", "description": "True for catalog/_base/* files"},
    "plugin": {"type": "string", "description": "Provider `name`: registry short name or dotted class path"},
    "provider_type": {"enum": ["feature", "coverage", "record", "map", "tile", "edr", "stac"]},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "ogc_api": {"type": "array", "items": {"enum": ["features", "coverages", "records", "maps", "tiles", "edr", "stac"]}},
    "origin": {"enum": ["core", "plugin", "created"]},
    "version": {"type": "string"},
    "source": {"type": "array", "items": {"type": "string"}},
    "docs": {"type": "string", "format": "uri"},
    "requires": {"type": "array", "items": {"type": "string"}},
    "query_types": {
      "description": "The EDR query types an edr provider offers (the contract harness checks them)",
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["position", "radius", "area", "cube", "trajectory", "corridor", "locations", "instances"]}
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bbox": {"type": "boolean"}, "datetime": {"type": "boolean"},
        "properties": {"type": "boolean"}, "sortby": {"type": "boolean"},
        "select_properties": {"type": "boolean"}, "skip_geometry": {"type": "boolean"},
        "q": {"type": "boolean"}, "hits": {"type": "boolean"}, "cql": {"type": "boolean"},
        "transactions": {"type": "boolean"}, "crs_native": {"type": "boolean"}
      }
    },
    "variants": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "title", "fields"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "title": {"type": "string"},
          "help": {"type": "string"},
          "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}}
        }
      }
    },
    "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
    "hide": {"type": "array", "items": {"type": "string"}, "description": "Base field keys this provider doesn't use"},
    "probe": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["feature", "record", "coverage", "edr", "tile", "map", "stac", "none"]},
        "copy_data": {"type": "boolean", "description": "Probe a temporary copy of `data` (providers that write to their file)"}
      }
    },
    "introspect": {
      "type": "object",
      "required": ["what"],
      "additionalProperties": false,
      "properties": {
        "what": {"enum": ["csv", "geojson", "sqlite", "sql", "ogr", "esri"]},
        "dialect": {"enum": ["postgresql", "mysql"]},
        "needs": {"type": "array", "items": {"type": "string"}},
        "table_key": {"description": "The form key that picks the table or layer whose columns fill pickers (default table)", "type": "string"},
        "source_key": {"description": "The form key a lookup needs before it runs (default data)", "type": "string"}
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}},
    "verdict": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {"status": {"enum": ["ok", "known-issue"]}, "note": {"type": "string"}}
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "provider"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "source": {"type": "string"},
          "variant": {"type": "string"},
          "provider": {"type": "object", "required": ["type", "name", "data"]}
        }
      }
    },
    "env": {
      "description": "Environment variables the provider reads itself (a created provider's spec placeholders); listed in the export instructions",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "secret": {"type": "boolean"},
          "help": {"type": "string"}
        }
      }
    },
    "egress": {
      "description": "Where the sandbox may connect for this provider (PLAN.md §8.2): sql reads data's host and port; spec reads the URLs of the spec data points at; url reads the http(s) URLs in the config keys named by keys (default data); hosts lists the host:port pairs a code-built provider declares",
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["sql", "spec", "url", "hosts"]},
        "keys": {
          "description": "With kind url: config keys whose value is a URL, such as data or data.source",
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"}
        },
        "default_port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "hosts": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9.-]+:[0-9]{1,5}$"}},
        "sql_keys": {
          "description": "With kind hosts: config keys whose value is a database connection (a mapping or a URL), such as data; the sandbox may reach its host and port",
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"}
        }
      }
    },
    "drift_ignore": {
      "type": "array",
      "description": "Keys the code reads that the descriptor deliberately leaves out, each with a reason (tools/drift_check.py)",
      "items": {
        "type": "object",
        "required": ["key", "reason"],
        "additionalProperties": false,
        "properties": {
          "key": {"type": "string"},
          "reason": {"type": "string"},
          "source": {"type": "string"}
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"base": {"const": true}}, "required": ["base"]},
     "else": {"required": ["plugin", "origin", "probe"]}}
  ],
  "$defs": {
    "field": {
      "description": "A form field. A descriptor's field with a base field's key overrides it and may leave out type and the other keys it inherits; every other field needs a type (checked when the catalog loads)",
      "type": "object",
      "required": ["key"],
      "additionalProperties": false,
      "properties": {
        "key": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z_][A-Za-z0-9_-]*)*$"},
        "type": {"enum": ["string", "text", "integer", "number", "boolean", "enum", "datetime",
                          "string[]", "number[]", "secret", "path", "url", "crs", "crs[]",
                          "bbox", "field", "field[]", "object", "yaml"]},
        "title": {"type": "string"},
        "help": {"type": "string"},
        "required": {"type": "boolean"},
        "default": {},
        "suggest": {},
        "choices": {"type": "array"},
        "choices_from": {"type": "string", "pattern": "^(probe|introspect)\\.[a-z_]+$"},
        "field_types": {"type": "array", "items": {"enum": ["string", "integer", "number", "boolean"]}},
        "extensions": {"type": "array", "items": {"type": "string", "pattern": "^\\.[a-z0-9]+$"}},
        "path_kind": {"description": "For path fields: a file (default), a folder (a tile tree), or either (a NetCDF file or a .zarr folder)", "enum": ["file", "folder", "any"]},
        "advanced": {"type": "boolean"},
        "step": {"enum": ["connect", "map"]},
        "unit": {"type": "string"},
        "min": {"type": "number"},
        "max": {"type": "number"},
        "pattern": {"type": "string"},
        "format": {"type": "string"},
        "show_if": {"type": "object"},
        "emit": {"enum": ["if_set", "always"]},
        "env_name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "drift": {"enum": ["checked", "passthrough", "docs_only"]},
        "source": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}, "minItems": 1}]},
        "docs": {"type": "string"},
        "deprecated": {"type": "boolean"},
        "geoconnex": {"type": "boolean"}
      }
    }
  }
}
