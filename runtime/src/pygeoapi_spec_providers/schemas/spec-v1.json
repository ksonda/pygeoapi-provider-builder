{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pygeoapi-provider-builder/runtime/spec-v1.json",
  "title": "Provider spec (v1)",
  "description": "A no-code pygeoapi provider. See PLAN.md §7.2. Semantic checks (JSONPath syntax, placeholder tokens, field references) live in spec.py.",
  "type": "object",
  "required": ["spec_version", "template", "id", "title"],
  "properties": {
    "spec_version": {"const": 1},
    "template": {"enum": ["http-features", "sql-features"]},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"template": {"const": "http-features"}}, "required": ["template"]},
      "then": {"$ref": "#/$defs/http_features"}
    },
    {
      "if": {"properties": {"template": {"const": "sql-features"}}, "required": ["template"]},
      "then": {"$ref": "#/$defs/sql_features"}
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "http_features": {
      "type": "object",
      "required": ["source", "records", "item_id", "geometry", "properties"],
      "properties": {
        "source": {"$ref": "#/$defs/source"},
        "records": {"$ref": "#/$defs/jsonpath"},
        "item_id": {
          "description": "Where each item's id comes from: a record key, or a JSONPath relative to the record",
          "type": "object",
          "required": ["from"],
          "additionalProperties": false,
          "properties": {"from": {"$ref": "#/$defs/value_ref"}}
        },
        "geometry": {"$ref": "#/$defs/geometry"},
        "properties": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/property"}
        },
        "time_field": {"$ref": "#/$defs/name"},
        "title_field": {"$ref": "#/$defs/name"},
        "pagination": {"$ref": "#/$defs/pagination"},
        "filters": {"$ref": "#/$defs/filters"},
        "item": {
          "type": "object",
          "required": ["url"],
          "additionalProperties": false,
          "properties": {
            "url": {"type": "string", "pattern": "^https?://"},
            "record": {"$ref": "#/$defs/jsonpath"}
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_records_scanned": {"type": "integer", "minimum": 1, "maximum": 100000},
            "max_pages": {"type": "integer", "minimum": 1, "maximum": 1000}
          }
        }
      }
    },
    "sql_features": {
      "type": "object",
      "required": ["source", "query", "item_id", "geometry", "properties"],
      "properties": {
        "source": {"$ref": "#/$defs/sql_source"},
        "query": {
          "description": "One read-only SELECT; the provider adds filters, sorting and paging around it (ADR-0007)",
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "item_id": {
          "description": "The column that identifies each row; its type, when it isn't a published property",
          "type": "object",
          "required": ["from"],
          "additionalProperties": false,
          "properties": {
            "from": {"$ref": "#/$defs/column"},
            "type": {"enum": ["string", "integer", "number"]}
          }
        },
        "geometry": {"$ref": "#/$defs/sql_geometry"},
        "properties": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/property"}
        },
        "time_field": {"$ref": "#/$defs/name"},
        "title_field": {"$ref": "#/$defs/name"},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"max_rows": {"type": "integer", "minimum": 1, "maximum": 100000}}
        }
      }
    },
    "sql_source": {
      "type": "object",
      "required": ["dialect"],
      "properties": {"dialect": {"enum": ["postgresql", "sqlite"]}},
      "allOf": [
        {
          "if": {"properties": {"dialect": {"const": "postgresql"}}, "required": ["dialect"]},
          "then": {
            "properties": {
              "dialect": true,
              "connection": {"$ref": "#/$defs/pg_connection"},
              "dsn": {"$ref": "#/$defs/secret"},
              "search_path": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sql_name"}},
              "connect_timeout_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 60},
              "statement_timeout_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 300}
            },
            "additionalProperties": false,
            "oneOf": [{"required": ["connection"]}, {"required": ["dsn"]}]
          }
        },
        {
          "if": {"properties": {"dialect": {"const": "sqlite"}}, "required": ["dialect"]},
          "then": {
            "required": ["path"],
            "properties": {
              "dialect": true,
              "path": {"description": "The database file, as the pygeoapi server sees it", "type": "string", "pattern": "^/"},
              "statement_timeout_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 300}
            },
            "additionalProperties": false
          }
        }
      ]
    },
    "pg_connection": {
      "type": "object",
      "required": ["host", "dbname", "user"],
      "additionalProperties": false,
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "port": {"type": ["integer", "string"]},
        "dbname": {"type": "string", "minLength": 1},
        "user": {"$ref": "#/$defs/secret"},
        "password": {"$ref": "#/$defs/secret"}
      }
    },
    "sql_geometry": {
      "type": "object",
      "required": ["encoding"],
      "properties": {"encoding": {"enum": ["native", "wkb", "wkt", "geojson", "gpkg", "xy", "none"]}},
      "allOf": [
        {
          "if": {"properties": {"encoding": {"enum": ["native", "wkb", "wkt", "geojson", "gpkg"]}}},
          "then": {
            "required": ["column"],
            "properties": {"encoding": true, "column": {"$ref": "#/$defs/column"}, "crs": {"$ref": "#/$defs/crs"}},
            "additionalProperties": false
          }
        },
        {
          "if": {"properties": {"encoding": {"const": "xy"}}},
          "then": {
            "required": ["x", "y"],
            "properties": {
              "encoding": true,
              "x": {"$ref": "#/$defs/column"},
              "y": {"$ref": "#/$defs/column"},
              "crs": {"$ref": "#/$defs/crs"}
            },
            "additionalProperties": false
          }
        },
        {
          "if": {"properties": {"encoding": {"const": "none"}}},
          "then": {"properties": {"encoding": true}, "additionalProperties": false}
        }
      ]
    },
    "column": {"description": "A column of the query's result", "type": "string", "minLength": 1, "maxLength": 128},
    "sql_name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_$]{0,62}$"},
    "source": {
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "url": {"type": "string", "pattern": "^https?://[^/?#@\\s]+"},
        "query": {
          "type": "object",
          "additionalProperties": {"type": ["string", "number", "boolean"]}
        },
        "headers": {"type": "object", "additionalProperties": {"type": "string"}},
        "auth": {"$ref": "#/$defs/auth"},
        "timeout_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 120},
        "retries": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max": {"type": "integer", "minimum": 0, "maximum": 5},
            "backoff_s": {"type": "number", "minimum": 0, "maximum": 30},
            "on_status": {
              "type": "array",
              "items": {"type": "integer", "minimum": 400, "maximum": 599}
            }
          }
        },
        "rate_limit": {
          "type": "object",
          "required": ["requests", "per_s"],
          "additionalProperties": false,
          "properties": {
            "requests": {"type": "integer", "minimum": 1},
            "per_s": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "cache_ttl_s": {"type": "integer", "minimum": 0, "maximum": 86400},
        "max_response_bytes": {"type": "integer", "minimum": 1, "maximum": 100000000},
        "error_path": {"$ref": "#/$defs/jsonpath"}
      }
    },
    "auth": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"enum": ["header", "query", "bearer", "basic"]}},
      "allOf": [
        {
          "if": {"properties": {"type": {"enum": ["header", "query"]}}},
          "then": {
            "required": ["name", "value"],
            "properties": {"type": true, "name": {"type": "string", "minLength": 1}, "value": {"$ref": "#/$defs/secret"}},
            "additionalProperties": false
          }
        },
        {
          "if": {"properties": {"type": {"const": "bearer"}}},
          "then": {
            "required": ["value"],
            "properties": {"type": true, "value": {"$ref": "#/$defs/secret"}},
            "additionalProperties": false
          }
        },
        {
          "if": {"properties": {"type": {"const": "basic"}}},
          "then": {
            "required": ["username", "password"],
            "properties": {"type": true, "username": {"$ref": "#/$defs/secret"}, "password": {"$ref": "#/$defs/secret"}},
            "additionalProperties": false
          }
        }
      ]
    },
    "geometry": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"enum": ["point", "wkt", "geojson", "none"]}},
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "point"}}},
          "then": {
            "required": ["x", "y"],
            "properties": {
              "type": true,
              "x": {"$ref": "#/$defs/value_ref"},
              "y": {"$ref": "#/$defs/value_ref"},
              "crs": {"$ref": "#/$defs/crs"}
            },
            "additionalProperties": false
          }
        },
        {
          "if": {"properties": {"type": {"enum": ["wkt", "geojson"]}}},
          "then": {
            "required": ["field"],
            "properties": {
              "type": true,
              "field": {"$ref": "#/$defs/value_ref"},
              "crs": {"$ref": "#/$defs/crs"}
            },
            "additionalProperties": false
          }
        },
        {
          "if": {"properties": {"type": {"const": "none"}}},
          "then": {"properties": {"type": true}, "additionalProperties": false}
        }
      ]
    },
    "property": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "type": {"enum": ["string", "integer", "number", "boolean", "datetime"]},
        "from": {"$ref": "#/$defs/value_ref"},
        "format": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      }
    },
    "pagination": {
      "type": "object",
      "required": ["style"],
      "additionalProperties": false,
      "properties": {
        "style": {"enum": ["none", "offset", "page", "next_link", "cursor"]},
        "offset_param": {"type": "string", "minLength": 1},
        "limit_param": {"type": "string", "minLength": 1},
        "max_page_size": {"type": "integer", "minimum": 1, "maximum": 10000},
        "page": {
          "type": "object",
          "required": ["page_param"],
          "additionalProperties": false,
          "properties": {
            "page_param": {"type": "string", "minLength": 1},
            "page_start": {"type": "integer", "minimum": 0},
            "size_param": {"type": "string", "minLength": 1}
          }
        },
        "next_link": {
          "type": "object",
          "required": ["next"],
          "additionalProperties": false,
          "properties": {"next": {"type": "string", "minLength": 1}}
        },
        "cursor": {
          "type": "object",
          "required": ["cursor_param", "cursor_path"],
          "additionalProperties": false,
          "properties": {
            "cursor_param": {"type": "string", "minLength": 1},
            "cursor_path": {"$ref": "#/$defs/jsonpath"}
          }
        },
        "total": {"$ref": "#/$defs/jsonpath"}
      },
      "allOf": [
        {"if": {"properties": {"style": {"const": "offset"}}}, "then": {"required": ["offset_param", "limit_param"]}},
        {"if": {"properties": {"style": {"const": "page"}}}, "then": {"required": ["page"]}},
        {"if": {"properties": {"style": {"const": "next_link"}}}, "then": {"required": ["next_link"]}},
        {"if": {"properties": {"style": {"const": "cursor"}}}, "then": {"required": ["cursor"]}}
      ]
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "type": "object",
          "required": ["param", "format"],
          "additionalProperties": false,
          "properties": {"param": {"type": "string", "minLength": 1}, "format": {"type": "string", "minLength": 1}}
        },
        "datetime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "param": {"type": "string", "minLength": 1},
            "start_param": {"type": "string", "minLength": 1},
            "end_param": {"type": "string", "minLength": 1},
            "format": {"type": "string", "minLength": 1}
          }
        },
        "properties": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "sortby": {
          "type": "object",
          "required": ["param", "properties"],
          "additionalProperties": false,
          "properties": {
            "param": {"type": "string", "minLength": 1},
            "format": {"type": "string", "minLength": 1},
            "orders": {
              "type": "object",
              "additionalProperties": false,
              "properties": {"asc": {"type": "string"}, "desc": {"type": "string"}}
            },
            "properties": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/name"}}
          }
        },
        "q": {
          "type": "object",
          "required": ["param"],
          "additionalProperties": false,
          "properties": {"param": {"type": "string", "minLength": 1}}
        }
      }
    },
    "secret": {
      "description": "A ${VAR} placeholder in the file; pygeoapi's yaml_load may re-type the value it substitutes",
      "type": ["string", "number", "boolean"]
    },
    "jsonpath": {"type": "string", "pattern": "^\\$"},
    "value_ref": {
      "description": "A key of the record, or a JSONPath relative to the record (starting with $)",
      "type": "string",
      "minLength": 1
    },
    "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"},
    "crs": {"type": "string", "pattern": "^https?://"}
  }
}
