class Observations:
    """Time series from the observations API, one location and parameter at a time."""

    def __init__(self, client: Client):
        self.client = client

    def fetch(self, location_id: Any, upstream: Any, start: datetime, end: datetime) -> Series:
        response = self.client.get(
            observations_url(location_id, upstream),
            observations_query(location_id, upstream, start, end),
            static=False,
        )
        if response.status in (404, 204):
            return []
        if not 200 <= response.status < 300:
            raise status_error(response)
        doc = response.json()
{% if c.obs.error_expr %}
        problem = {{ c.obs.error_expr }}
        if problem not in (None, '', [], {}, False):
            return []  # "no data", from an API that answers HTTP 200 with an error body
{% endif %}
        series: Series = []
        for record in {{ c.obs.records_expr }}:
{% if c.obs.parameter_expr %}
            if str({{ c.obs.parameter_expr }}) != str(upstream):
                continue
{% endif %}
            moment = parse_datetime({{ c.obs.time_expr }}, TIME_FORMAT)
            if moment is None:
                continue
            series.append((moment, coerce({{ c.obs.value_expr }}, 'number')))
        return series


@functools.lru_cache(maxsize=8)
def observations_for({% for o in c.obs.auth_options %}{{ o.var }}: str{% if not loop.last %}, {% endif %}{% endfor %}) -> Observations:
    """One client per process: pygeoapi creates a provider per request."""
{% if c.obs.rate_limit %}
    host = next(iter(OBSERVATIONS_HOSTS))
{% endif %}
    return Observations(
        Client(
            OBSERVATIONS_HOSTS,
{% for name, value in c.obs.client_args %}
            {{ name }}={{ value }},
{% endfor %}
        )
    )
{% else %}


class Observations:
    """Time series from the observations query, one location and parameter at a time."""

    def __init__(self, database: Database):
        self.database = database

    def fetch(self, location_id: Any, upstream: Any, start: datetime, end: datetime) -> Series:
        params = {
{% for name, expr in c.obs.params %}
            {{ name }}: {{ expr }},
{% endfor %}
        }
        with self.database.connect() as conn:
            columns, found = rows(conn, OBSERVATIONS_QUERY, params)
        index = {name: i for i, name in enumerate(columns)}
        t_col, v_col = index.get(TIME_COLUMN), index.get(VALUE_COLUMN)
        if t_col is None or v_col is None:
            missing = [c for c in (TIME_COLUMN, VALUE_COLUMN) if c not in index]
            raise DatabaseError(f'The query has no column {missing[0]!r}', kind='query')
{% if c.obs.parameter_column %}
        p_col = index.get(PARAMETER_COLUMN)
{% endif %}
        series: Series = []
        for row in found:
{% if c.obs.parameter_column %}
            if p_col is not None and str(row[p_col]) != str(upstream):
                continue
{% endif %}
            moment = parse_datetime(row[t_col], TIME_FORMAT)
            if moment is not None:
                series.append((moment, coerce(row[v_col], 'number')))
        return series
{% endif %}


