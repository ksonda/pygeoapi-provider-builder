Series = list[tuple[datetime, Any]]


def haversine_km(a: tuple[float, float], b: tuple[float, float]) -> float:
    lon1, lat1, lon2, lat2 = map(math.radians, (a[0], a[1], b[0], b[1]))
    h = (
        math.sin((lat2 - lat1) / 2) ** 2
        + math.cos(lat1) * math.cos(lat2) * math.sin((lon2 - lon1) / 2) ** 2
    )
    return 2 * EARTH_KM * math.asin(math.sqrt(h))


def point_of(feature: Mapping[str, Any]) -> tuple[float, float] | None:
    """A location's longitude and latitude (a point inside, for other geometries)."""
    geometry = feature.get('geometry')
    if not geometry:
        return None
    try:
        geom = shape(geometry)
    except (ValueError, TypeError, AttributeError):
        return None
    if geom.is_empty:
        return None
    inside = geom if geom.geom_type == 'Point' else geom.representative_point()
    return float(inside.x), float(inside.y)


def window(datetime_: str | None, now: datetime | None = None) -> tuple[datetime, datetime]:
    """The interval a request asks for: its ``datetime``, filled in with DEFAULT_WINDOW."""
    now = now or datetime.now(UTC)
    start, end = parse_interval(datetime_) if datetime_ else (None, None)
    if start is None and end is None:
        start, end = now - DEFAULT_WINDOW, now
    elif end is None:
        end = start + DEFAULT_WINDOW
    elif start is None:
        start = end - DEFAULT_WINDOW
    if end < start:
        raise ProviderInvalidQueryError(user_msg='The datetime interval ends before it starts.')
    if end - start > MAX_WINDOW:
        raise ProviderInvalidQueryError(
            user_msg=f'Ask for at most {MAX_WINDOW_TEXT} of observations at a time.'
        )
    return start, end


def parameter_ids(select: Sequence[str] | None) -> list[str]:
    """The parameters a request asks for (``parameter-name``), or all of them."""
    if not select:
        return list(FIELDS)
    unknown = [p for p in select if p not in FIELDS]
    if unknown:
        raise ProviderInvalidQueryError(user_msg=f'Unknown parameter-name {unknown[0]}')
    return list(dict.fromkeys(select))


def cap(limit: int | None) -> int:
    return max(1, min(int(limit or MAX_LOCATIONS), MAX_LOCATIONS))


def coverage(
    location: Mapping[str, Any], xy: tuple[float, float], pid: str, series: Series
) -> dict[str, Any]:
    """One location's time series of one parameter, as a CoverageJSON PointSeries."""
    series = sorted(series, key=lambda s: s[0])[:MAX_OBSERVATIONS]
    return {
        'type': 'Coverage',
        'id': f'{location["id"]}-{pid}',
        'domain': {
            'type': 'Domain',
            'domainType': 'PointSeries',
            'axes': {
                'x': {'values': [xy[0]]},
                'y': {'values': [xy[1]]},
                't': {'values': [to_iso(t) for t, _ in series]},
            },
            'referencing': [copy.deepcopy(GEOGRAPHIC_CRS), copy.deepcopy(TEMPORAL_RS)],
        },
        'ranges': {
            pid: {
                'type': 'NdArray',
                'dataType': 'float',
                'axisNames': ['t'],
                'shape': [len(series)],
                'values': [v for _, v in series],
            }
        },
    }


@contextmanager
def errors() -> Iterator[None]:
    """Failures reading observations as pygeoapi errors, with a ``user_msg``."""
    try:
        yield
