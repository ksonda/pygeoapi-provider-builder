{% for query_type in c.query_types %}
{% if query_type == 'locations' %}

    def locations(
        self,
        location_id: str | None = None,
        bbox: Sequence[float] | None = None,
        datetime_: str | None = None,
        select_properties: Sequence[str] | None = None,
        limit: int | None = None,
        **kwargs: Any,
    ) -> dict[str, Any]:
        """Without ``location_id``, the monitoring locations (GeoJSON); with one, its series."""
        with errors():
            if not location_id:
                features = self.find(bbox, cap(limit))
                return {
                    'type': 'FeatureCollection',
                    'features': features,
                    'numberReturned': len(features),
                }
            try:
                location = self.sites.get(location_id)
            except ProviderItemNotFoundError as err:
                raise ProviderItemNotFoundError(user_msg='Unknown location id.') from err
            return self.collection([location], select_properties, datetime_)
{% elif query_type == 'position' %}

    def position(
        self,
        wkt: Any = None,
        datetime_: str | None = None,
        select_properties: Sequence[str] | None = None,
        **kwargs: Any,
    ) -> dict[str, Any]:
        """The series of the location nearest ``coords=POINT(x y)``, within SNAP_RADIUS_KM."""
        if wkt is None or getattr(wkt, 'geom_type', None) != 'Point':
            raise ProviderInvalidQueryError(user_msg='position needs coords=POINT(x y).')
        with errors():
            location = self.nearest(wkt)
            return self.collection([location], select_properties, datetime_)
{% elif query_type == 'area' %}

    def area(
        self,
        wkt: Any = None,
        datetime_: str | None = None,
        select_properties: Sequence[str] | None = None,
        limit: int | None = None,
        **kwargs: Any,
    ) -> dict[str, Any]:
        """The series of the locations inside ``coords=POLYGON((…))``."""
        if wkt is None or getattr(wkt, 'geom_type', None) not in ('Polygon', 'MultiPolygon'):
            raise ProviderInvalidQueryError(user_msg='area needs coords=POLYGON((…)).')
        with errors():
            candidates = self.find(list(wkt.bounds), 10_000)
            inside = [f for f in candidates if (xy := point_of(f)) and wkt.intersects(Point(xy))]
            return self.collection(inside[: cap(limit)], select_properties, datetime_)
{% elif query_type == 'cube' %}

    def cube(
        self,
        bbox: Sequence[float] | None = None,
        datetime_: str | None = None,
        select_properties: Sequence[str] | None = None,
        limit: int | None = None,
        **kwargs: Any,
    ) -> dict[str, Any]:
        """The series of the locations inside ``bbox``."""
        if not bbox:
            raise ProviderInvalidQueryError(user_msg='cube needs a bbox.')
        with errors():
            area = box(*bounds(bbox))
            candidates = self.find(list(area.bounds), 10_000)
            inside = [f for f in candidates if (xy := point_of(f)) and area.intersects(Point(xy))]
            return self.collection(inside[: cap(limit)], select_properties, datetime_)
{% endif %}
{% endfor %}

    def find(self, bbox: Sequence[float] | None, limit: int) -> list[dict[str, Any]]:
        """Monitoring locations, inside ``bbox`` when there is one."""
        return list(self.sites.query(offset=0, limit=limit, bbox=bbox or None)['features'])

    def nearest(self, point: Any) -> dict[str, Any]:
        """The location nearest a point, within SNAP_RADIUS_KM."""
        x, y = float(point.x), float(point.y)
        dlat = SNAP_RADIUS_KM / 111.0
        dlon = SNAP_RADIUS_KM / max(1e-6, 111.32 * math.cos(math.radians(y)))
        candidates = self.find([x - dlon, y - dlat, x + dlon, y + dlat], 10_000)
        best: tuple[float, dict[str, Any]] | None = None
        for feature in candidates:
            xy = point_of(feature)
            if xy is None:
                continue
            km = haversine_km((x, y), xy)
            if km <= SNAP_RADIUS_KM and (best is None or km < best[0]):
                best = (km, feature)
        if best is None:
            raise ProviderNoDataError(
                user_msg=f'No monitoring location within {SNAP_RADIUS_KM:g} km of that point.'
            )
        return best[1]

    def collection(
        self,
        locations: Sequence[dict[str, Any]],
        select: Sequence[str] | None,
        datetime_: str | None,
    ) -> dict[str, Any]:
        """A CoverageCollection: one PointSeries per location and parameter with observations."""
        pids = parameter_ids(select)
        start, end = window(datetime_)
        coverages, used = [], set()
        for location in locations:
            xy = point_of(location)
            if xy is None:
                continue
            for pid in pids:
                series = self.observations.fetch(location['id'], UPSTREAM[pid], start, end)
                if series:
                    coverages.append(coverage(location, xy, pid, series))
                    used.add(pid)
        if not coverages:
            raise ProviderNoDataError(user_msg='No observations match this query.')
        return {
            'type': 'CoverageCollection',
            'domainType': 'PointSeries',
            'parameters': {pid: copy.deepcopy(PARAMETERS[pid]) for pid in pids if pid in used},
            'coverages': coverages,
        }

    def __repr__(self) -> str:
        return '<{{ c.class_name }}>'
